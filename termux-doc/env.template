# ============================================================
# RSSHub 环境变量配置
# ============================================================
# 使用方法: 复制为 env 并修改
#   cp env.template env
#   nano env

export NODE_ENV=production
export NODE_OPTIONS=--max-http-header-size=32768

# 服务端口 (默认: 1200)
export PORT=1200

# 监听所有网络接口 (局域网访问)
export LISTEN_INADDR_ANY=true