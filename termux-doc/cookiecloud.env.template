# ============================================================
# CookieCloud 配置
# ============================================================
# 使用方法: 复制为 cookiecloud.env 并修改
#   cp cookiecloud.env.template cookiecloud.env
#   nano cookiecloud.env
#
# CookieCloud 服务器: https://github.com/easychen/CookieCloud

# CookieCloud 服务器地址 (必填)
export COOKIE_CLOUD_HOST=http://127.0.0.1:8088

# 用户 UUID (必填，在 CookieCloud 浏览器扩展中获取)
export COOKIE_CLOUD_UUID=your-uuid

# 端对端加密密码 (必填)
export COOKIE_CLOUD_PASSWORD=your-password

# 同步间隔 (秒，默认: 3600)
export COOKIE_CLOUD_INTERVAL=3600

# 启用调试路由 /cookiecloud/:keys (默认: false)
export COOKIE_CLOUD_DEBUG=true